# LeadForge environment configuration
# Copy to .env and fill in real values
# Required: DATABASE_URL, REDIS_URL, SECRET_KEY, ENCRYPTION_KEY, ANTHROPIC_API_KEY
# Optional: API keys for external services (needed for scraping/verification)

DATABASE_URL=postgresql+asyncpg://leadforge:leadforge@localhost:5432/leadforge
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-64-char-string
# ENCRYPTION_KEY: base64-encoded 32 random bytes
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

APIFY_API_TOKEN=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
ZEROBOUNCE_API_KEY=
SERPAPI_KEY=

ANTHROPIC_API_KEY=
